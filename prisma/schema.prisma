// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  BEER
  CIDER_RTD
  BRANDY
  WHISKY
  COGNAC
  GIN
  VODKA
  VODKA_PREMIUM
  TEQUILA
  TEQUILA_PREMIUM
  LIQUEUR
  MIXER
  WINE
  WINE_BOX
  SPARKLING
  CHAMPAGNE
  WATER
  ICE
}

enum OrderStatus {
  PAYMENT_PENDING
  PENDING
  DISPATCHED
  DELIVERED
}

enum AdminRole {
  SUPER_ADMIN // full access: dispatch, delete, inventory, manage other admins
  DISPATCHER  // day-to-day ops: view/assign/dispatch/deliver orders only
}

// ── Admin roles ──────────────────────────────────────────
// Delegated admins beyond the ADMIN_EMAILS env var bootstrap. Anyone in
// ADMIN_EMAILS is implicitly SUPER_ADMIN (that's the root bootstrap — you
// need at least one admin to be able to grant anyone else access at all).
// This table is for adding more admins with an actual role, instead of
// every allowlisted email getting full access by default. See
// requireAdmin/requireSuperAdmin in server.js.
model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      AdminRole @default(DISPATCHER)
  createdAt DateTime  @default(now())
}

// ── Catalog ──────────────────────────────────────────────
// Supplier fields are preserved verbatim from the supplier price sheet
// (skus.csv). Retail fields are Ekoyini's own customer-facing pricing,
// computed in prisma/seed.js — see the rationale comment there.
model SkuItem {
  id                String   @id @default(cuid())
  name              String
  category          Category
  productType       String
  bottleFormat      String
  supplierPortfolio String

  // Supplier price sheet (cost/procurement reference — not shown to customers)
  listPriceZAR              Float // supplier's single-unit price
  unitsPerCase              Int
  supplierCaseDiscountPct   Float
  supplierCasePriceZAR      Float
  palletPackQty              Int
  supplierPalletDiscountPct Float
  supplierPalletPriceZAR    Float

  // Retail pricing (customer-facing, computed at seed time)
  retailSingleZAR       Float // = listPriceZAR (already shelf-realistic)
  retailCaseDiscountPct Float // Ekoyini's own carry-pack discount, by category
  retailCaseZAR          Float // = retailSingleZAR * unitsPerCase * (1 - retailCaseDiscountPct/100)

  imageUrl   String?
  orderItems OrderItem[]

  // Real inventory tracking. Defaults high (not "unlimited") because no
  // actual per-SKU stock count exists yet from any supplier feed — 999 is
  // an honest placeholder that keeps today's behavior (always orderable)
  // while making the enforcement mechanism itself real from day one.
  // Update actual counts via the admin Inventory tab as they become known.
  stock Int @default(999)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, bottleFormat])
}

// ── Taverns (supply partners) ───────────────────────────
model Tavern {
  id     String  @id @default(cuid())
  name   String
  area   String
  phone  String
  orders Order[]
}

// ── Promo Codes ──────────────────────────────────────────
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Float
  minSubtotal Float?
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

// ── Orders ───────────────────────────────────────────────
// userId links back to the Supabase Auth user (auth.users.id) who placed
// the order. It's a plain string, not a Prisma relation, because the
// users table lives in Supabase's own "auth" schema, not this one.
model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  userId        String?
  address       String
  customerName  String?
  customerPhone String?
  paymentMethod String      @default("cod")
  status        OrderStatus @default(PAYMENT_PENDING)
  promoCode     String?
  promoDiscount Float?
  total         Float
  items         OrderItem[]
  tavern        Tavern?     @relation(fields: [tavernId], references: [id])
  tavernId      String?
  driverName    String?
  driverPhone   String?
  driverVehicle String?
  rating        Int?
  ratingComment String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id       String   @id @default(cuid())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  sku      SkuItem? @relation(fields: [skuId], references: [id])
  skuId    String?
  name     String
  price    Float
  quantity Int
}
