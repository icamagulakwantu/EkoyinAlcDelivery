// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  BEER
  CIDER_RTD
  BRANDY
  WHISKY
  COGNAC
  GIN
  VODKA
  VODKA_PREMIUM
  TEQUILA
  TEQUILA_PREMIUM
  LIQUEUR
  MIXER
  WINE
  WINE_BOX
  SPARKLING
  CHAMPAGNE
  WATER
  ICE
}

enum OrderStatus {
  PAYMENT_PENDING
  PENDING
  DISPATCHED
  DELIVERED
}

enum AdminRole {
  SUPER_ADMIN // full access: dispatch, delete, inventory, manage other admins
  DISPATCHER  // day-to-day ops: view/assign/dispatch/deliver orders only
}

// ── Admin roles ──────────────────────────────────────────
// Delegated admins beyond the ADMIN_EMAILS env var bootstrap. Anyone in
// ADMIN_EMAILS is implicitly SUPER_ADMIN (that's the root bootstrap — you
// need at least one admin to be able to grant anyone else access at all).
// This table is for adding more admins with an actual role, instead of
// every allowlisted email getting full access by default. See
// requireAdmin/requireSuperAdmin in server.js.
model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      AdminRole @default(DISPATCHER)
  createdAt DateTime  @default(now())
}

// Every consequential admin action gets a row here — who, what, on what,
// when. Nothing reads or enforces against this table; it exists purely as
// a record, so "who deleted order EKO-XXXXX" or "who zeroed out this
// SKU's stock" has an answer instead of a shrug.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // e.g. "ASSIGN_ORDER", "UPDATE_STATUS", "DELETE_ORDER", "UPDATE_STOCK", "ADD_ADMIN", "REMOVE_ADMIN"
  targetId   String? // order code, product id, admin email — whatever the action's subject was
  detail     String? // short freeform description of what changed
  createdAt  DateTime @default(now())
}

// ── Catalog ──────────────────────────────────────────────
// Supplier fields are preserved verbatim from the supplier price sheet
// (skus.csv). Retail fields are Ekoyini's own customer-facing pricing,
// computed in prisma/seed.js — see the rationale comment there.
model SkuItem {
  id                String   @id @default(cuid())
  name              String
  category          Category
  productType       String
  bottleFormat      String
  supplierPortfolio String

  // Supplier price sheet (cost/procurement reference — not shown to customers)
  listPriceZAR              Float // supplier's single-unit price
  unitsPerCase              Int
  supplierCaseDiscountPct   Float
  supplierCasePriceZAR      Float
  palletPackQty              Int
  supplierPalletDiscountPct Float
  supplierPalletPriceZAR    Float

  // Retail pricing (customer-facing, computed at seed time)
  retailSingleZAR       Float // = listPriceZAR (already shelf-realistic)
  retailCaseDiscountPct Float // Ekoyini's own carry-pack discount, by category
  retailCaseZAR          Float // = retailSingleZAR * unitsPerCase * (1 - retailCaseDiscountPct/100)

  imageUrl   String?
  orderItems OrderItem[]

  // Brand story tags — "BLACK_OWNED" | "WOMEN_OWNED" | "CELEBRITY_BACKED".
  // Only ever set from a specific, checked fact about that brand (a named
  // founder still holding real equity, a documented current partnership) —
  // never inferred from category, portfolio name, or "sounds independent".
  // A brand that was founder-owned but has since been fully acquired (no
  // ongoing founder equity or active partnership) does NOT get a tag, even
  // if its origin story is still told in marketing — see the seed data's
  // sourcing notes for exactly what was checked and why. Empty by default,
  // which is the honest state until a claim is actually verified.
  brandTags String[] @default([])

  // Real inventory tracking. Defaults high (not "unlimited") because no
  // actual per-SKU stock count exists yet from any supplier feed — 999 is
  // an honest placeholder that keeps today's behavior (always orderable)
  // while making the enforcement mechanism itself real from day one.
  // Update actual counts via the admin Inventory tab as they become known.
  stock Int @default(999)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, bottleFormat])
}

// ── Taverns (supply partners) ───────────────────────────
model Tavern {
  id     String  @id @default(cuid())
  name   String
  area   String
  phone  String
  orders Order[]
}

// ── Card checkout (Yoco) ─────────────────────────────────
// Card payment can't create an Order the moment checkout starts — the
// customer hasn't paid yet, and Yoco's own docs say never trust the
// success-redirect for confirmation, only the webhook. So this table
// holds the full order payload + the amount actually quoted to Yoco
// while the customer is on Yoco's hosted page; POST /webhooks/yoco
// verifies the payment actually succeeded, then (and only then) runs
// the same order-creation path COD/EFT already uses, using the payload
// stored here. Nothing here ever touches stock or a promo code's
// usedCount — that still only happens inside the real order transaction.
model PendingCheckout {
  id              String    @id @default(cuid())
  userId          String
  yocoCheckoutId  String    @unique
  amountCents     Int
  payload         String // JSON-encoded: { address, items, customerName, customerPhone, promoCode }
  status          String    @default("PENDING") // PENDING | COMPLETED | FAILED_NEEDS_REFUND
  orderCode       String? // set once the real Order is created
  failureReason   String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

// ── Promo Codes ──────────────────────────────────────────
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Float
  minSubtotal Float?
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

// ── Orders ───────────────────────────────────────────────
// userId links back to the Supabase Auth user (auth.users.id) who placed
// the order. It's a plain string, not a Prisma relation, because the
// users table lives in Supabase's own "auth" schema, not this one.
model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  userId        String?
  address       String
  customerName  String?
  customerPhone String?
  paymentMethod String      @default("cod")
  status        OrderStatus @default(PAYMENT_PENDING)
  promoCode     String?
  promoDiscount Float?
  total         Float
  items         OrderItem[]
  tavern        Tavern?     @relation(fields: [tavernId], references: [id])
  tavernId      String?
  driverName       String?
  driverPhone      String?
  driverVehicle    String?
  // Real live location — driver-track.html posts to POST /order/:code/location
  // using driverShareToken as the auth (no driver account exists, so this is
  // the same "secret in the URL" pattern the order tracking code itself
  // uses). track.html shows a live map once these are set and recent.
  driverShareToken String?
  driverLat        Float?
  driverLng        Float?
  driverLocationAt DateTime?
  rating           Int?
  ratingComment    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id       String   @id @default(cuid())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  sku      SkuItem? @relation(fields: [skuId], references: [id])
  skuId    String?
  name     String
  price    Float
  quantity Int
}
