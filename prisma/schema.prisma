// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  BEER
  CIDER_RTD
  BRANDY
  WHISKY
  COGNAC
  GIN
  VODKA
  VODKA_PREMIUM
  TEQUILA
  TEQUILA_PREMIUM
  LIQUEUR
  MIXER
  WINE
  WINE_BOX
  SPARKLING
  CHAMPAGNE
  WATER
  ICE
  RUM
  ENERGY_DRINK
}

enum OrderStatus {
  PAYMENT_PENDING
  PENDING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN // full access: dispatch, delete, inventory, manage other admins
  DISPATCHER  // day-to-day ops: view/assign/dispatch/deliver orders only
}

// ── Admin roles ────────────────────────────────────────────────────────
// Delegated admins beyond the ADMIN_EMAILS env var bootstrap. Anyone in
// ADMIN_EMAILS is implicitly SUPER_ADMIN (that's the root bootstrap — you
// need at least one admin to be able to grant anyone else access at all).
// This table is for adding more admins with an actual role, instead of
// every allowlisted email getting full access by default. See
// requireAdmin/requireSuperAdmin in server.js.
model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      AdminRole @default(DISPATCHER)
  createdAt DateTime  @default(now())
}

// One row per device (phone or computer) that tapped "Turn on order alerts"
// in the admin dashboard, so new orders can ring it even when the app is
// closed (web push, lib/push.js). Devices of people who stop being admins
// are removed the next time an alert is sent.
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  adminEmail String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([adminEmail])
}

// ── Driver app ─────────────────────────────────────────────────────────
// Drivers sign in with their phone number (saved as 27XXXXXXXXX, the same
// value as Order.driverPhone) and a 6-digit PIN that admin creates. Only a
// scrypt hash of the PIN and a hash of the session token are stored.
model Driver {
  id               String    @id @default(cuid())
  phone            String    @unique
  name             String
  vehicle          String?
  pinHash          String
  active           Boolean   @default(true)
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  sessionHash      String?
  sessionExpiresAt DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([sessionHash])
}

// Tavern portal (founder approved 21 Nov 2026). A partner tavern signs in with
// the tavern phone number (Tavern.phone, saved 27XXXXXXXXX) and a 6-digit PIN
// that admin creates. Kept in its own table so the hashes can never ride along
// when a Tavern is included in an order response. Only scrypt hashes are stored.
model TavernAccess {
  id               String    @id @default(cuid())
  tavernId         String    @unique
  pinHash          String
  active           Boolean   @default(true)
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  sessionHash      String?
  sessionExpiresAt DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([sessionHash])
}

// An item a tavern has told us it cannot supply right now. Stock stays shared
// and prices stay platform-wide; this only steers which tavern an order goes to.
model TavernSoldOut {
  id        String   @id @default(cuid())
  tavernId  String
  skuId     String
  createdAt DateTime @default(now())

  @@unique([tavernId, skuId])
  @@index([skuId])
}

// Every consequential admin action gets a row here — who, what, on what,
// when. Nothing reads or enforces against this table; it exists purely as
// a record, so "who deleted order EKO-XXXXX" or "who zeroed out this
// SKU's stock" has an answer instead of a shrug.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // e.g. "ASSIGN_ORDER", "UPDATE_STATUS", "DELETE_ORDER", "UPDATE_STOCK", "ADD_ADMIN", "REMOVE_ADMIN", "CANCEL_ORDER"
  targetId   String? // order code, product id, admin email — whatever the action's subject was
  detail     String? // short freeform description of what changed
  createdAt  DateTime @default(now())
}

// ── Catalog ────────────────────────────────────────────────────────────
// Supplier fields are preserved verbatim from the supplier price sheet
// (skus.csv). Retail fields are Ekoyini's own customer-facing pricing,
// computed in prisma/seed.js — see the rationale comment there.
model SkuItem {
  id                String   @id @default(cuid())
  name              String
  category          Category
  productType       String
  bottleFormat      String
  supplierPortfolio String

  // Supplier price sheet (cost/procurement reference — not shown to customers)
  listPriceZAR              Float // source retail unit price before Ekoyini's 25% markup
  unitsPerCase              Int
  supplierCaseDiscountPct   Float
  supplierCasePriceZAR      Float // source supplier case cost
  palletPackQty              Int
  supplierPalletDiscountPct Float
  supplierPalletPriceZAR    Float

  // Retail pricing (customer-facing, computed at seed time)
  retailSingleZAR       Float // = listPriceZAR (already shelf-realistic)
  retailCaseDiscountPct Float // Ekoyini's own carry-pack discount, by category
  retailCaseZAR          Float // = retailSingleZAR * unitsPerCase * (1 - retailCaseDiscountPct/100)

  // How many bottles/cans one "single" purchase contains. Dumpies and cans
  // are sold only as six-packs (packSize 6), so retailSingleZAR is the price
  // of a whole six-pack. Everything else is 1. Column is added/converted by
  // scripts/ensure-schema.js.
  packSize Int @default(1)

  imageUrl   String?
  orderItems OrderItem[]

  // Brand story tags — "BLACK_OWNED" | "WOMEN_OWNED" | "CELEBRITY_BACKED".
  // Only ever set from a specific, checked fact about that brand (a named
  // founder still holding real equity, a documented current partnership) —
  // never inferred from category, portfolio name, or "sounds independent".
  // A brand that was founder-owned but has since been fully acquired (no
  // ongoing founder equity or active partnership) does NOT get a tag, even
  // if its origin story is still told in marketing — see the seed data's
  // sourcing notes for exactly what was checked and why. Empty by default,
  // which is the honest state until a claim is actually verified.
  brandTags String[] @default([])

  // Real inventory tracking. Defaults high (not "unlimited") because no
  // actual per-SKU stock count exists yet from any supplier feed — 999 is
  // an honest placeholder that keeps today's behavior (always orderable)
  // while making the enforcement mechanism itself real from day one.
  // Update actual counts via the admin Inventory tab as they become known.
  stock Int @default(999)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, bottleFormat])
}

// ── Taverns (supply partners) ─────────────────────────────────────────
model Tavern {
  id     String  @id @default(cuid())
  name   String
  area   String
  phone  String
  // Where the tavern is, used to work out the delivery distance. Set in the
  // admin dashboard (Delivery tab); columns are added by
  // scripts/ensure-schema.js. A tavern without coordinates is ignored when
  // measuring distance.
  latitude  Float?
  longitude Float?
  orders Order[]
}

// ── Delivery settings ──────────────────────────────────────────────────
// A single row (id "default"). Created by scripts/ensure-schema.js.
model DeliverySettings {
  id           String   @id
  surgesEnabled Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt
}

// ── Card checkout (Yoco) ──────────────────────────────────────────────────
// Card payment can't create an Order the moment checkout starts — the
// customer hasn't paid yet, and Yoco's own docs say never trust the
// success-redirect for confirmation, only the webhook. So this table
// holds the full order payload + the amount actually quoted to Yoco
// while the customer is on Yoco's hosted page; POST /webhooks/yoco
// verifies the payment actually succeeded, then (and only then) runs
// the same order-creation path COD/EFT already uses, using the payload
// stored here. Nothing here ever touches stock or a promo code's
// usedCount — that still only happens inside the real order transaction.
model PendingCheckout {
  id              String    @id @default(cuid())
  userId          String
  yocoCheckoutId  String    @unique
  amountCents     Int
  payload         String // JSON-encoded: { address, items, customerName, customerPhone, promoCode, landmark, deliveryLat, deliveryLng, priorityFee }
  status          String    @default("PENDING") // PENDING | PROCESSING (claimed while creating the order) | COMPLETED | FAILED_NEEDS_REFUND
  orderCode       String? // set once the real Order is created
  failureReason   String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

// ── Promo Codes ────────────────────────────────────────────────────────
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Float
  minSubtotal Float?
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

// ── Orders ────────────────────────────────────────────────────────────────
// userId links back to the Supabase Auth user (auth.users.id) who placed
// the order. It's a plain string, not a Prisma relation, because the
// users table lives in Supabase's own "auth" schema, not this one.
model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  userId        String?
  address       String
  // Township and informal-settlement addresses are often hard for a driver
  // to find from the street address alone. The customer can drop a GPS pin
  // ("use my location") and/or describe a landmark ("blue gate opposite the
  // spaza"). All optional — an order without them works exactly as before.
  landmark      String?
  deliveryLat   Float?
  deliveryLng   Float?
  customerName  String?
  customerPhone String?
  // Captured at creation (same reason customerName/customerPhone are
  // denormalized here rather than looked up live) — needed to email an
  // EFT payment confirmation later, after the request that created the
  // Supabase Auth session is long gone.
  customerEmail String?
  paymentMethod String      @default("cod")
  status        OrderStatus @default(PAYMENT_PENDING)
  promoCode     String?
  promoDiscount Float?

  // Delivery fee breakdown saved at order time (older orders have nulls).
  // total already includes all of these.
  distanceKm  Float? // straight-line distance x 1.2 routing buffer
  deliveryFee Float? // distance-based fee (always charged; no free delivery)
  surgeFee    Float? // peak / late-night surge, 100% to the driver
  priorityFee Float? // optional "Super Priority" the customer added
  serviceFee  Float? // Care & Handling fee, 5% / 7% / 15% of subtotal
  safetySealFee Float? // optional R10 tamper-evident seals (spirits only)
  bottleDepositFee Float? // returnable quarts: R52 per crate of 12, R3 per loose bottle (founder, 10 Nov 2026)
  deliveredAt   DateTime? // set when the order is delivered (payouts are per delivery day)
  // Proven pickup and delivery (founder, 18 Nov 2026): the tavern gives the
  // driver the collection PIN; the customer gives the driver the delivery PIN.
  collectionPin String?
  deliveryPin   String?
  paidAt        DateTime? // when the order became paid (PENDING)
  assignedAt    DateTime? // when a tavern + driver were assigned
  pickedUpAt    DateTime? // when the driver confirmed pickup
  readyAt       DateTime? // when the tavern marked the order ready for collection
  alertsSent    String?   // JSON: alert kinds/levels already emailed

  total         Float
  items         OrderItem[]
  tavern        Tavern?     @relation(fields: [tavernId], references: [id])
  tavernId      String?
  driverName       String?
  driverPhone      String?
  driverVehicle    String?
  // Real live location — driver-track.html posts to POST /order/:code/location
  // using driverShareToken as the auth (no driver account exists, so this is
  // the same "secret in the URL" pattern the order tracking code itself
  // uses). track.html shows a live map once these are set and recent.
  driverShareToken String?
  driverLat        Float?
  driverLng        Float?
  driverLocationAt DateTime?
  rating           Int?
  ratingComment    String?

  // Cash-on-delivery risk flag — set when a COD order's amount and/or
  // contents deviate sharply from this customer's own purchase history
  // (see assessCodEligibility in server.js). Never blocks the order by
  // itself; it just surfaces a "worth a second look before dispatch" on
  // the admin dashboard. Always false/null for non-COD orders.
  codFlagged   Boolean @default(false)
  codFlagReason String?

  // Set when a customer or admin cancels the order (see
  // cancelOrderTransaction in server.js). Stock for every line item is
  // restored atomically in the same transaction that sets this.
  cancelReason String?

  // Lets a customer remove a cancelled/delivered order from their own
  // "My Orders" list without actually deleting the record — admin still
  // sees every order regardless of this flag, so dispatch history, sales
  // records, and the audit trail are never affected by what a customer
  // chooses to hide from their own view.
  hiddenByCustomer Boolean @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id       String   @id @default(cuid())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  sku      SkuItem? @relation(fields: [skuId], references: [id])
  skuId    String?
  name     String
  price    Float
  quantity Int
}

// ── Driver reports ────────────────────────────────────────────────────────
// A customer complaint about the driver on one of their orders (rude,
// unsafe, late, tampered package...). driverName/driverPhone are copied at
// report time so the record survives a later re-assignment. Table is
// created by scripts/ensure-schema.js. Reviewed in the admin dashboard.
model DriverReport {
  id          String   @id @default(cuid())
  orderCode   String
  userId      String
  driverName  String?
  driverPhone String?
  category    String // RUDE | UNSAFE | LATE | TAMPERED | OTHER
  message     String
  status      String   @default("OPEN") // OPEN | REVIEWED | RESOLVED
  createdAt   DateTime @default(now())

  @@index([orderCode])
}

// ── Marketing consent (POPIA s69) ─────────────────────────────────────
// One row per customer account. Marketing (specials on WhatsApp, SMS or
// email) may only be sent while optedIn is true. Order updates don't need
// this. Opting out keeps the row (with optedOutAt) as proof of the change.
model MarketingConsent {
  id         String    @id @default(cuid())
  userId     String    @unique // Supabase auth user id
  email      String?
  name       String?
  phone      String?
  optedIn    Boolean   @default(false)
  optedInAt  DateTime?
  optedOutAt DateTime?
  source     String? // "checkout", "signup", "profile", "unsubscribe-link"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ── Payouts (founder, 11 Nov 2026) ──────────────────────────────────────
// One row per driver or tavern paid for a period ("2026-11-10" or
// "2026-11-04..2026-11-10"), so nobody is paid twice. Amounts are worked
// out by lib/payouts.js from delivered orders.
model Payout {
  id         String   @id @default(cuid())
  period     String
  payeeType  String // DRIVER | TAVERN
  payeeKey   String // driver phone (27...) or tavern id
  payeeName  String
  amount     Float
  orderCodes String // JSON array
  paidBy     String?
  paidAt     DateTime @default(now())

  @@unique([period, payeeType, payeeKey])
}

// The 12:00 payout summary email, sent once per day.
model PayoutEmail {
  day    String   @id
  sentAt DateTime @default(now())
}

// ── Staff files (founder approved 22 Nov 2026) ────────────────────────
// One proper record per driver or dispatcher: SA ID, home address, driver's
// licence, vehicle and number plate, and bank details for payouts. ID, licence
// and account numbers are stored ENCRYPTED (AES-256-GCM, Render env
// STAFF_DATA_KEY, lib/staff-profile.js); only the last 4 digits are kept in
// the clear for display. Super-admin only, every reveal is audit-logged.
// kind DRIVER links by driverId; kind DISPATCHER links by adminEmail (lowercase).
model StaffProfile {
  id                String    @id @default(cuid())
  kind              String // DRIVER | DISPATCHER
  driverId          String?   @unique
  adminEmail        String?   @unique
  fullName          String
  idNumberEnc       String
  idNumberHash      String    @unique // HMAC, stops the same person being filed twice
  idLast4           String
  email             String
  phone             String
  addressLine       String
  suburb            String
  city              String
  postalCode        String
  licenceNumberEnc  String?
  licenceLast4      String?
  licenceCode       String?
  licenceExpiry     DateTime?
  vehicleMake       String?
  vehicleModel      String?
  vehicleColour     String?
  vehicleYear       Int?
  numberPlate       String?
  vehicleRegNumber  String? // number on the vehicle registration certificate
  vehicleDiscExpiry DateTime?
  bankName          String?
  accountHolder     String?
  accountNumberEnc  String?
  accountLast4      String?
  branchCode        String?
  accountType       String?
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
