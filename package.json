{
  "name": "ekoyini",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/ensure-schema.js && node server.js",
    "test": "node --test",
    "postinstall": "prisma generate && node scripts/ensure-schema.js && node scripts/run-catalogue-structure.js && node prisma/sync-images.js && node prisma/audit-catalogue.js && node scripts/run-catalogue-prices.js",
    "prisma:generate": "prisma generate",
    "migrate": "node scripts/migrate.js",
    "migrate:new": "prisma migrate dev --create-only",
    "seed": "node prisma/seed.js && node prisma/catalogue-update.js",
    "catalogue-update": "node prisma/catalogue-update.js",
    "enrich-images": "node scripts/enrich-images.js",
    "optimize-images": "node scripts/optimize-images.js",
    "sync-images": "node prisma/sync-images.js",
    "ensure-schema": "node scripts/ensure-schema.js",
    "catalogue:photos:dry-run": "node prisma/sync-images.js --dry-run",
    "catalogue:photos:sync": "node prisma/sync-images.js",
    "catalogue:audit": "node prisma/audit-catalogue.js",
    "catalogue:dry-run": "node prisma/catalogue-update.js --dry-run",
    "catalogue:structure:dry-run": "node prisma/catalogue-update.js --dry-run --structure-only",
    "catalogue:prices:dry-run": "node prisma/catalogue-update.js --dry-run --prices-only",
    "catalogue:structure": "node prisma/catalogue-update.js --structure-only",
    "catalogue:prices": "node prisma/catalogue-update.js --prices-only",
    "catalogue:unpriced:dry-run": "node prisma/sync-images.js --dry-run --include-unpriced",
    "catalogue:unpriced:sync": "node prisma/sync-images.js --include-unpriced"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "express-rate-limit": "^7.4.1",
    "prisma": "^5.20.0",
    "sharp": "^0.34.0"
  }
}
