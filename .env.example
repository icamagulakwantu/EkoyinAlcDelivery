# Supabase Postgres connection string
# Supabase dashboard → Project Settings → Database → Connection string → URI
# NOTE: the direct host above (db.[PROJECT-REF].supabase.co) is IPv6-only.
# Deploying to a host without outbound IPv6 (e.g. Render)? Use the Session
# pooler string instead — same dashboard page, under "Connection pooling":
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# See DEPLOYMENT.md for details.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth (email/password admin + customer login)
# Supabase dashboard → Project Settings → API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# Admin access to /orders and other admin routes. Two mechanisms, both live:
# 1) ADMIN_EMAILS — comma-separated allowlist of Supabase Auth account
#    emails that may use the admin dashboard (admin/admin.html). Sign up
#    each admin as a normal customer account first (public/signup.html or
#    the Supabase dashboard), then add their email here.
# 2) ADMIN_API_TOKEN — a shared secret for scripts/curl (e.g. the
#    /admin/enrich-images trigger) and as a bootstrap path before any
#    admin account exists. Once every admin has a real account, you can
#    remove this to require real per-user auth only.
ADMIN_EMAILS="you@example.com"
ADMIN_API_TOKEN="change-me-to-a-long-random-string"

# Resend — order confirmation + admin alert emails. Get a key at
# resend.com (free tier is fine to start). Leave blank and email just
# silently no-ops; nothing else in the app depends on it.
RESEND_API_KEY=""
# Optional — defaults to Resend's own onboarding@resend.dev test address,
# which works with zero setup. Once you've verified a domain in the Resend
# dashboard, switch to something like "Ekoyini <orders@yourdomain.com>".
RESEND_FROM_EMAIL=""

# Yoco (card payments). Get keys from the Yoco Business Portal →
# Developer → API Keys. Leave YOCO_SECRET_KEY blank and the "Debit/Credit
# Card" option at checkout just stays disabled, exactly as it is today —
# nothing else changes.
#   ⚠ Built against Yoco's public docs, not yet verified against a live
#   account — see the top of payments.js before relying on this for real
#   money. Test with a Yoco sandbox checkout first.
YOCO_SECRET_KEY=""
# The signing secret Yoco gives you when you register a webhook (Yoco
# Business Portal → Developer → Webhooks) pointed at
# https://<your-render-domain>/webhooks/yoco, subscribed to
# payment.succeeded. Required for card payments to actually complete —
# without it, POST /webhooks/yoco rejects everything (can't verify the
# signature), so a paid Yoco checkout would never turn into a real order.
YOCO_WEBHOOK_SECRET=""

# Optional — overrides the base URL used to build Yoco's success/cancel/
# failure redirect URLs. Only needed if req.protocol/req.get('host')
# ever guesses wrong (e.g. behind a proxy setup other than Render's
# default). Leave blank normally.
APP_BASE_URL=""

# Set automatically by Render — no action needed
PORT=3000
