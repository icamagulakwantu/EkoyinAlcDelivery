# Supabase Postgres connection string
# Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth (email/password admin + customer login)
# Supabase dashboard → Project Settings → API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# Stopgap admin auth for /orders and other admin routes.
# TODO: replace with real Supabase Auth session checks (Track B step 3).
ADMIN_API_TOKEN="change-me-to-a-long-random-string"

# Resend (Track B — order confirmation + admin alert emails)
RESEND_API_KEY=""

# Set automatically by Render — no action needed
PORT=3000
